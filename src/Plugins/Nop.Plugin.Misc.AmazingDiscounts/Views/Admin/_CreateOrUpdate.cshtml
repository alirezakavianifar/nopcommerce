@model AmazingDiscountProductModel

@if (Model.Id > 0)
{
    <input asp-for="Id" type="hidden" />
}

<div class="content">
    <div class="form-horizontal">
        <div class="card card-default">
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="ProductId" />
                    </div>
                    <div class="col-md-9">
                        <nop-select asp-for="ProductId" asp-items="Model.AvailableProducts" />
                        <span asp-validation-for="ProductId" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="CustomLabel" />
                    </div>
                    <div class="col-md-9">
                        <input asp-for="CustomLabel" class="form-control" />
                        <span asp-validation-for="CustomLabel" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="DisplayOrder" />
                    </div>
                    <div class="col-md-9">
                        <input asp-for="DisplayOrder" class="form-control" type="number" />
                        <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="StartDateUtc" />
                    </div>
                    <div class="col-md-9">
                        <input asp-for="StartDateUtc" class="form-control" type="datetime-local" />
                        <span asp-validation-for="StartDateUtc" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="EndDateUtc" />
                    </div>
                    <div class="col-md-9">
                        <input asp-for="EndDateUtc" class="form-control" type="datetime-local" />
                        <span asp-validation-for="EndDateUtc" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
