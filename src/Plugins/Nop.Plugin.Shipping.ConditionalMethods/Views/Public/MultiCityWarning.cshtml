@model MultiCityWarningModel

@if (Model.HasMultipleCities)
{
    <div class="conditional-shipping-multicity-warning" id="multicity-shipping-warning" style="margin: 20px 0; padding: 20px; border-radius: 12px; background: #fffbeb; border: 2px solid #f59e0b; box-shadow: 0 8px 20px rgba(245, 158, 11, 0.12); direction: rtl; text-align: right; font-family: inherit;">
        <div style="display: flex; align-items: flex-start; gap: 14px;">
            <span style="display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 10px; background: #fef3c7; color: #d97706; font-size: 24px; flex-shrink: 0;">⚠️</span>
            <div style="flex: 1;">
                <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-bottom: 8px;">
                    <h4 style="margin: 0; font-size: 16px; font-weight: 700; color: #92400e;">تشخیص تداخل ارسال از چند شهر و انبار مختلف (Multi-City Conflict)</h4>
                    <span style="background: #f59e0b; color: #fff; font-size: 11.5px; font-weight: 600; padding: 3px 10px; border-radius: 14px;">مستلزم انتخاب شیوه تحویل</span>
                </div>
                <p style="margin: 0 0 12px; font-size: 13.5px; color: #78350f; line-height: 1.7;">
                    سبد خرید شما شامل محصولاتی از انبارهای مستقر در شهرهای مختلف است:
                    <strong style="color: #b45309; text-decoration: underline;">@(Model.Cities != null ? string.Join("، ", Model.Cities) : "تهران، مشهد")</strong>.
                    جهت نهایی‌سازی سفارش، یکی از دو شیوه زیر را انتخاب فرمایید:
                </p>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; margin-bottom: 16px;">
                    <!-- Choice 1: Cart Correction -->
                    <div style="background: #ffffff; border: 1px solid #fde68a; border-radius: 8px; padding: 12px;">
                        <h5 style="margin: 0 0 4px; font-size: 13.5px; color: #1e293b; font-weight: 700;">🛒 گزینه ۱: اصلاح سبد خرید (خرید از یک شهر)</h5>
                        <p style="margin: 0; font-size: 12px; color: #64748b; line-height: 1.6;">اقلام شهرهای دیگر را حذف نمایید تا کلیه محصولات از یک مبدا ارسال شده و سرویس <strong>ارسال فوری و پیک</strong> فعال گردد.</p>
                    </div>

                    <!-- Choice 2: Split Multi-Shipment Invoicing -->
                    <div style="background: #ffffff; border: 1px solid #fde68a; border-radius: 8px; padding: 12px;">
                        <h5 style="margin: 0 0 4px; font-size: 13.5px; color: #1e293b; font-weight: 700;">📦 گزینه ۲: تفکیک فاکتور ارسال (صدور مرسوله‌های مجزا)</h5>
                        <p style="margin: 0; font-size: 12px; color: #64748b; line-height: 1.6;">مرسوله‌ها از انبارهای هر شهر به طور مستقل بسته‌بندی و ارسال شده و مجموع هزینه‌های حمل در فاکتور نهایی اعمال خواهد شد.</p>
                    </div>
                </div>

                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <a href="/cart" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 18px; border-radius: 8px; background: #fff; border: 1px solid #d97706; color: #92400e; font-size: 13px; font-weight: 600; text-decoration: none;">
                        <span>🛒</span> ویرایش و اصلاح سبد خرید
                    </a>
                    <button type="button" onclick="document.getElementById('multicity-shipping-warning').style.display='none'" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 20px; border-radius: 8px; background: #d97706; border: none; color: #fff; font-size: 13px; font-weight: 600; cursor: pointer;">
                        <span>✓</span> تایید و تفکیک مرسوله‌ها (پرداخت مجموع)
                    </button>
                </div>
            </div>
        </div>
    </div>
}
