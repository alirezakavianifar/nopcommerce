@model MultiCityWarningModel

@if (Model.HasMultipleCities)
{
    <div class="conditional-shipping-multicity-warning alert alert-warning" id="multicity-shipping-warning">
        <div class="d-flex align-items-start">
            <div class="flex-shrink-0 me-3">
                <i class="fas fa-exclamation-triangle fa-2x"></i>
            </div>
            <div class="flex-grow-1">
                <h5 class="alert-heading">Multiple Warehouse Cities Detected</h5>
                <p>
                    Your cart contains products from warehouses located in different cities:
                    <strong>@string.Join(", ", Model.Cities)</strong>.
                </p>
                <p>
                    You have two options:
                </p>
                <ul>
                    <li>
                        <strong>Proceed with separate shipments</strong> — each warehouse city will ship independently
                        and you will see a combined shipping cost covering all cities.
                    </li>
                    <li>
                        <strong>Modify your cart</strong> — remove items from warehouses in other cities so that all
                        products ship from a single city to get city-specific conditional shipping options
                        (Express, Courier, etc.).
                    </li>
                </ul>
                <div class="mt-2">
                    <a href="/cart" class="btn btn-sm btn-outline-secondary me-2">
                        <i class="fas fa-shopping-cart"></i> Modify Cart
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-primary"
                            onclick="document.getElementById('multicity-shipping-warning').style.display='none'">
                        <i class="fas fa-check"></i> Proceed with Separate Shipments
                    </button>
                </div>
            </div>
        </div>
    </div>

    <style>
        .conditional-shipping-multicity-warning {
            margin-bottom: 1.5rem;
            border-left: 4px solid #ffc107;
        }
    </style>
}
