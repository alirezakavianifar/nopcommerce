@model WorkflowModel
@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Misc.UserNotifications.AddWorkflow").Text;
    NopHtml.SetActiveMenuItemSystemName("Misc.UserNotifications.Workflows");
}

<form asp-action="CreateWorkflow" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">@T("Plugins.Misc.UserNotifications.AddWorkflow")</h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i> @T("Plugins.Misc.UserNotifications.SaveWorkflow")
            </button>
            <a asp-action="Workflows" class="btn btn-default">@T("Plugins.Misc.UserNotifications.BackToWorkflows")</a>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="card card-default">
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-3">
                            <label>@T("Plugins.Misc.UserNotifications.WorkflowName")</label>
                        </div>
                        <div class="col-md-9">
                            <input asp-for="Name" class="form-control" placeholder="@T("Plugins.Misc.UserNotifications.WorkflowName")" required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <label>@T("Plugins.Misc.UserNotifications.TriggerAction")</label>
                        </div>
                        <div class="col-md-9">
                            <select asp-for="TriggerTypeId" class="form-control">
                                <option value="1">ثبت‌نام کاربر (پیام خوش‌آمدگویی / Welcome Drip)</option>
                                <option value="2">ثبت سفارش (پیام تشکر و پیشنهاد خرید / Post-Purchase)</option>
                                <option value="3">مشاهده محصول (پیام تبلیغاتی و معرفی محصول / Product Drip)</option>
                                <option value="4">افزودن به علاقه‌مندی‌ها (یادآوری و کد تخفیف / Cart-Wishlist Recovery)</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <label>@T("Plugins.Misc.UserNotifications.IsActive")</label>
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="IsActive" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
