@model CustomerInboxListModel
@{
    Layout = "_ColumnsTwo";
    ViewBag.PageTitle = T("Plugins.Misc.UserNotifications.Inbox").Text;
}

@section left
{
    @await Component.InvokeAsync("CustomerNavigation", new { selectedTabId = 200 })
}

<div class="page account-page notifications-inbox-page">
    <div class="page-title">
        <h1>@T("Plugins.Misc.UserNotifications.Inbox") (@Model.UnreadCount @T("Plugins.Misc.UserNotifications.Inbox.Unread"))</h1>
    </div>
    <div class="page-body mt-4">
        @if (Model.Items != null && Model.Items.Any())
        {
            <div class="list-group">
                @foreach (var item in Model.Items)
                {
                    <div class="list-group-item list-group-item-action flex-column align-items-start @(item.IsRead ? "" : "border-left border-primary bg-light") mb-2 p-3 shadow-sm rounded">
                        <div class="d-flex w-100 justify-content-between align-items-center mb-1">
                            <h5 class="mb-1 font-weight-bold">
                                @if (!item.IsRead)
                                {
                                    <span class="badge badge-primary mr-2">@T("Plugins.Misc.UserNotifications.Inbox.New")</span>
                                }
                                @item.Title
                            </h5>
                            <small class="text-muted">@item.CreatedOnUtc.ToString("g")</small>
                        </div>
                        <p class="mb-2 text-dark">@item.Message</p>
                        @if (!string.IsNullOrWhiteSpace(item.ActionUrl))
                        {
                            <a href="@item.ActionUrl" class="btn btn-sm btn-outline-primary mt-1">@T("Plugins.Misc.UserNotifications.Inbox.ViewDetails")</a>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info">@T("Plugins.Misc.UserNotifications.Inbox.Empty")</div>
        }
    </div>
</div>
