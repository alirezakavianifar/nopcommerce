@model CustomerInboxListModel
@using Nop.Plugin.Misc.UserNotifications.Models
@{
    Layout = "_ColumnsTwo";
    ViewBag.PageTitle = T("Plugins.Misc.UserNotifications.Inbox").Text;
}

@section left
{
    @await Component.InvokeAsync("CustomerNavigation", new { selectedTabId = 200 })
}

<link rel="stylesheet" href="~/Plugins/Misc.UserNotifications/Content/css/notifications.css" />
<script src="~/Plugins/Misc.UserNotifications/Content/js/notifications.js" defer></script>

<div class="page account-page notifications-hub-page">
    <div class="page-title d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 font-weight-bold mb-0">
            <i class="fas fa-bell text-primary mr-2"></i> @T("Plugins.Misc.UserNotifications.Inbox")
            @if (Model.UnreadCount > 0)
            {
                <span class="badge badge-pill badge-danger notif-unread-count ml-2 font-weight-normal" style="font-size: 0.9rem;">
                    @Model.UnreadCount @T("Plugins.Misc.UserNotifications.Inbox.Unread")
                </span>
            }
        </h1>
        <div>
            <a href="/customer/notifications/preferences" class="btn btn-outline-secondary button-2 btn-sm">
                <i class="fas fa-cog mr-1"></i> @T("Plugins.Misc.UserNotifications.Preferences")
            </a>
        </div>
    </div>

    <div class="page-body">
        <div class="notif-hub-wrapper">
        <!-- Toolbar: Filters & Search -->
        <div class="notif-hub-toolbar">
            <div class="notif-hub-filters">
                <a href="/customer/notifications?category=All" class="notif-hub-pill @(Model.CurrentCategory == "All" && !Model.UnreadOnly.GetValueOrDefault() ? "active" : "")">
                    <i class="fas fa-layer-group mr-1"></i> @T("Plugins.Misc.UserNotifications.FilterAll")
                </a>
                <a href="/customer/notifications?category=Order" class="notif-hub-pill @(Model.CurrentCategory == "Order" ? "active" : "")">
                    <i class="fas fa-box mr-1"></i> @T("Plugins.Misc.UserNotifications.FilterOrders")
                </a>
                <a href="/customer/notifications?category=Promotion" class="notif-hub-pill @(Model.CurrentCategory == "Promotion" ? "active" : "")">
                    <i class="fas fa-gift mr-1"></i> @T("Plugins.Misc.UserNotifications.FilterOffers")
                </a>
                <a href="/customer/notifications?category=System" class="notif-hub-pill @(Model.CurrentCategory == "System" ? "active" : "")">
                    <i class="fas fa-bullhorn mr-1"></i> @T("Plugins.Misc.UserNotifications.FilterSystem")
                </a>
                <a href="/customer/notifications?unread=true" class="notif-hub-pill @(Model.UnreadOnly.GetValueOrDefault() ? "active" : "")">
                    <i class="fas fa-envelope mr-1"></i> @T("Plugins.Misc.UserNotifications.Inbox.Unread")
                </a>
            </div>

            <div class="notif-hub-actions">
                @if (Model.UnreadCount > 0)
                {
                    <button type="button" class="notif-action-btn" onclick="UserNotifications.markAllAsRead()">
                        <i class="fas fa-check-double text-success mr-1"></i> @T("Plugins.Misc.UserNotifications.MarkAllAsRead")
                    </button>
                }
                <button type="button" class="notif-action-btn" onclick="clearReadNotifications()">
                    <i class="fas fa-trash-alt text-muted mr-1"></i> @T("Plugins.Misc.UserNotifications.ClearRead")
                </button>
            </div>
        </div>

        <!-- Search Bar -->
        <form method="get" action="/customer/notifications" class="mb-4">
            <input type="hidden" name="category" value="@Model.CurrentCategory" />
            <div class="input-group">
                <input type="text" name="q" class="form-control" placeholder="@T("Plugins.Misc.UserNotifications.SearchPlaceholder")" value="@Model.SearchKeyword" />
                <div class="input-group-append">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search mr-1"></i> @T("Common.Search")
                    </button>
                </div>
            </div>
        </form>

        <!-- Notification Cards List -->
        @if (Model.Items != null && Model.Items.Any())
        {
            <div class="notif-cards-list">
                @foreach (var item in Model.Items)
                {
                    <div id="notif-card-@item.Id" class="notif-hub-card @(item.IsRead ? "" : "unread")">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="notif-thumb" alt="Product" />
                        }
                        else
                        {
                            <div class="notif-item-icon category-@item.Category">
                                <i class="fas @item.Icon"></i>
                            </div>
                        }

                        <div class="flex-grow-1" style="min-width: 0;">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <h4 class="notif-item-title mb-0" style="font-size: 1rem;">
                                    @if (!item.IsRead)
                                    {
                                        <span class="badge badge-primary mr-2" style="font-size: 0.7rem;">@T("Plugins.Misc.UserNotifications.Inbox.New")</span>
                                    }
                                    @item.Title
                                </h4>
                                <span class="text-muted" style="font-size: 0.78rem;">@item.RelativeTime</span>
                            </div>

                            <p class="notif-item-message text-secondary mb-2" style="font-size: 0.88rem; -webkit-line-clamp: unset;">@item.Message</p>

                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2">
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrWhiteSpace(item.CouponCode))
                                    {
                                        <span class="notif-coupon-tag" onclick="UserNotifications.copyCoupon('@item.CouponCode', event)">
                                            <i class="fas fa-ticket-alt"></i> @item.CouponCode (@T("Plugins.Misc.UserNotifications.CopyCode"))
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.ActionUrl))
                                    {
                                        <a href="@item.ActionUrl" class="btn btn-sm btn-primary py-1 px-3">
                                            @T("Plugins.Misc.UserNotifications.Inbox.ViewDetails")
                                        </a>
                                    }
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    @if (!item.IsRead)
                                    {
                                        <button type="button" class="btn btn-link btn-sm text-primary p-0" onclick="markSingleRead(@item.Id)">
                                            <i class="fas fa-check mr-1"></i> @T("Plugins.Misc.UserNotifications.MarkAsRead")
                                        </button>
                                    }
                                    <button type="button" class="btn btn-link btn-sm text-danger p-0 ml-2" onclick="deleteNotificationItem(@item.Id)">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-center mt-4">
                    <nav aria-label="Notifications pagination">
                        <ul class="pagination">
                            @if (Model.HasPreviousPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="/customer/notifications?category=@Model.CurrentCategory&q=@Model.SearchKeyword&page=@Model.PageIndex">@T("Common.Previous")</a>
                                </li>
                            }
                            <li class="page-item active">
                                <span class="page-link">@(Model.PageIndex + 1) / @Model.TotalPages</span>
                            </li>
                            @if (Model.HasNextPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="/customer/notifications?category=@Model.CurrentCategory&q=@Model.SearchKeyword&page=@(Model.PageIndex + 2)">@T("Common.Next")</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="notif-empty-state my-5">
                <div class="notif-empty-icon" style="font-size: 3.5rem;">
                    <i class="far fa-bell-slash"></i>
                </div>
                <h3 class="notif-empty-title">@T("Plugins.Misc.UserNotifications.Inbox.Empty")</h3>
                <p class="notif-empty-desc mb-3">@T("Plugins.Misc.UserNotifications.Inbox.AllCaughtUp")</p>
                <a href="/" class="btn btn-primary px-4">
                    <i class="fas fa-shopping-bag mr-1"></i> @T("Plugins.Misc.UserNotifications.StartShopping")
                </a>
            </div>
        }
    </div>
    </div>
</div>

<script>
    function markSingleRead(id) {
        var card = document.getElementById('notif-card-' + id);
        UserNotifications.markAsRead(id, card);
    }

    function deleteNotificationItem(id) {
        if (!confirm('@T("Admin.Common.AreYouSure")')) return;
        fetch('/customer/notifications/delete?id=' + id, { method: 'POST' })
            .then(function (res) { return res.json(); })
            .then(function (data) {
                var card = document.getElementById('notif-card-' + id);
                if (card) {
                    card.style.opacity = '0';
                    setTimeout(function () { card.remove(); }, 200);
                }
                var unreadCount = data ? (data.unreadCount !== undefined ? data.unreadCount : data.UnreadCount) : undefined;
                if (typeof unreadCount !== 'undefined') {
                    UserNotifications.updateBadge(unreadCount);
                }
            });
    }

    function clearReadNotifications() {
        if (!confirm('@T("Admin.Common.AreYouSure")')) return;
        fetch('/customer/notifications/clear-read', { method: 'POST' })
            .then(function () {
                location.reload();
            });
    }
</script>
