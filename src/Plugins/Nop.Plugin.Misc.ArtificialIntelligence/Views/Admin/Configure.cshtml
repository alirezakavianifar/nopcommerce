@model Nop.Plugin.Misc.ArtificialIntelligence.Models.AiSettingsModel
@using Nop.Web.Framework.Extensions
@using System.Globalization

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Misc.ArtificialIntelligence.Configure").Text;
    var isPersian = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.StartsWith("fa", StringComparison.OrdinalIgnoreCase);
}

<form asp-controller="AiAdmin" asp-action="Configure" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Misc.ArtificialIntelligence.Configure")
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i> @T("Admin.Common.Save")
            </button>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="card card-default">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-cog"></i> @T("Admin.Configuration")</h3>
                    </div>
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="ProviderTypeId" class="col-form-label">@(isPersian ? "ارائه‌دهنده هوش مصنوعی" : "AI Provider Infrastructure")</label>
                            </div>
                            <div class="col-md-9">
                                <select asp-for="ProviderTypeId" class="form-control" id="ProviderTypeSelect">
                                    <option value="0">@(isPersian ? "ابر AvalAI (سرویس ابری)" : "Cloud AvalAI API (Cloud Service)")</option>
                                    <option value="1">@(isPersian ? "زیرساخت محلی / درون‌سازمانی (Local Self-Hosted)" : "Local Self-Hosted Infrastructure (Whisper / Ollama / LocalAI)")</option>
                                    <option value="2">@(isPersian ? "حالت تست / شبیه‌ساز (Sandbox Mock)" : "Sandbox Mock Mode (Simulated Responses)")</option>
                                </select>
                                <span asp-validation-for="ProviderTypeId" class="text-danger"></span>
                                <small class="form-text text-muted">@(isPersian ? "انتخاب کنید که پردازش‌های هوش مصنوعی (ماژول B و دیگر امکانات) از طریق سرویس ابری انجام شوند یا زیرساخت سرور محلی." : "Select whether AI operations (Module B & other features) are processed via cloud APIs or your local server infrastructure.")</small>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="SandboxMode" class="col-form-label">@T("Plugins.Misc.ArtificialIntelligence.SandboxMode")</label>
                            </div>
                            <div class="col-md-9">
                                <div class="custom-control custom-switch">
                                    <input asp-for="SandboxMode" type="checkbox" class="custom-control-input" id="SandboxModeSwitch">
                                    <label class="custom-control-label" for="SandboxModeSwitch">@(isPersian ? "فعال‌سازی حالت تست / شبیه‌ساز (بدون فراخوانی API خارجی، تست‌ها از پاسخ‌های شبیه‌سازی شده استفاده خواهند کرد)" : "Enable Sandbox (No external API calls, tests will use simulated responses)")</label>
                                </div>
                                <span asp-validation-for="SandboxMode" class="text-danger"></span>
                            </div>
                        </div>

                        <div id="cloud-provider-section">
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <label asp-for="ApiKey" class="col-form-label">@T("Plugins.Misc.ArtificialIntelligence.ApiKey")</label>
                                </div>
                                <div class="col-md-9">
                                    <input asp-for="ApiKey" class="form-control" placeholder="@(isPersian ? "کلید API پلتفرم AvalAI (توکن Bearer) را وارد کنید" : "Enter AvalAI API Key (Bearer Token)")" />
                                    <span asp-validation-for="ApiKey" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-3">
                                    <label asp-for="BaseUrl" class="col-form-label">@T("Plugins.Misc.ArtificialIntelligence.BaseUrl")</label>
                                </div>
                                <div class="col-md-9">
                                    <input asp-for="BaseUrl" class="form-control" />
                                    <span asp-validation-for="BaseUrl" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="CreditThreshold" class="col-form-label">@T("Plugins.Misc.ArtificialIntelligence.CreditThreshold")</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="CreditThreshold" type="number" class="form-control" placeholder="@(isPersian ? "حد آستانه را به تومان وارد کنید" : "Enter threshold in Tomans")" />
                                <span asp-validation-for="CreditThreshold" class="text-danger"></span>
                                <small class="form-text text-muted">@(isPersian ? "هنگامی که اعتبار باقی‌مانده به این حد آستانه برسد یا کمتر از آن شود، یک هشدار سیستمی صادر خواهد شد." : "A system warning will be triggered when the remaining credit reaches or drops below this threshold.")</small>
                            </div>
                        </div>

                        @if (Model.CurrentCredit.HasValue)
                        {
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <label class="col-form-label">@(isPersian ? "اعتبار باقی‌مانده فعلی" : "Current Remaining Credit")</label>
                                </div>
                                <div class="col-md-9">
                                    <div class="form-control-plaintext font-weight-bold @(Model.CurrentCredit <= Model.CreditThreshold ? "text-danger" : "text-success")">
                                        @Model.CurrentCredit.Value.ToString("N0") @(isPersian ? "تومان" : "Tomans")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card card-default" id="local-provider-card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-server"></i> @(isPersian ? "تنظیمات زیرساخت محلی / درون‌سازمانی (Local Self-Hosted)" : "Local Infrastructure Configuration")</h3>
                    </div>
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="LocalSttEndpoint" class="col-form-label">@(isPersian ? "اندپوینت تبدیل گفتار به متن محلی (STT - Whisper)" : "Local STT Endpoint (Whisper)")</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="LocalSttEndpoint" class="form-control" placeholder="http://localhost:8000/v1/audio/transcriptions" />
                                <span asp-validation-for="LocalSttEndpoint" class="text-danger"></span>
                                <small class="form-text text-muted">@(isPersian ? "آدرس سرویس محلی Faster-Whisper یا Whisper.cpp یا LocalAI برای ماژول B (جستجوی صوتی)" : "Endpoint for self-hosted Faster-Whisper, Whisper.cpp, or LocalAI for Module B Voice Search")</small>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="LocalSttModel" class="col-form-label">@(isPersian ? "نام مدل STT محلی" : "Local STT Model")</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="LocalSttModel" class="form-control" placeholder="whisper-1" />
                                <span asp-validation-for="LocalSttModel" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="LocalEmbeddingEndpoint" class="col-form-label">@(isPersian ? "اندپوینت Embedding محلی" : "Local Embedding Endpoint")</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="LocalEmbeddingEndpoint" class="form-control" placeholder="http://localhost:11434/api/embeddings" />
                                <span asp-validation-for="LocalEmbeddingEndpoint" class="text-danger"></span>
                                <small class="form-text text-muted">@(isPersian ? "آدرس سرویس محلی Ollama یا Text Embeddings Inference (TEI)" : "Endpoint for local Ollama, TEI, or ONNX embeddings")</small>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="LocalEmbeddingModel" class="col-form-label">@(isPersian ? "نام مدل Embedding محلی" : "Local Embedding Model")</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="LocalEmbeddingModel" class="form-control" placeholder="bge-m3" />
                                <span asp-validation-for="LocalEmbeddingModel" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="LocalVisionEndpoint" class="col-form-label">@(isPersian ? "اندپوینت بینایی ماشین محلی (Vision)" : "Local Vision Endpoint")</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="LocalVisionEndpoint" class="form-control" placeholder="http://localhost:11434/v1/chat/completions" />
                                <span asp-validation-for="LocalVisionEndpoint" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="LocalVisionModel" class="col-form-label">@(isPersian ? "نام مدل Vision محلی" : "Local Vision Model")</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="LocalVisionModel" class="form-control" placeholder="qwen2-vl" />
                                <span asp-validation-for="LocalVisionModel" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="LocalChatEndpoint" class="col-form-label">@(isPersian ? "اندپوینت چت‌بات محلی (Chat)" : "Local Chat Endpoint")</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="LocalChatEndpoint" class="form-control" placeholder="http://localhost:11434/v1/chat/completions" />
                                <span asp-validation-for="LocalChatEndpoint" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="LocalChatModel" class="col-form-label">@(isPersian ? "نام مدل Chat محلی" : "Local Chat Model")</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="LocalChatModel" class="form-control" placeholder="llama3" />
                                <span asp-validation-for="LocalChatModel" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="LocalApiKey" class="col-form-label">@(isPersian ? "کلید API / توکن احراز هویت محلی (اختیاری)" : "Local API Key / Bearer Token (Optional)")</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="LocalApiKey" class="form-control" placeholder="Optional Authorization Bearer token" />
                                <span asp-validation-for="LocalApiKey" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="EnableClientWebSpeechFallback" class="col-form-label">@(isPersian ? "پشتیبانی از Web Speech API مرروگر (جستجوی صوتی مستقیم وب)" : "Enable Web Speech API Browser Fallback")</label>
                            </div>
                            <div class="col-md-9">
                                <div class="custom-control custom-switch">
                                    <input asp-for="EnableClientWebSpeechFallback" type="checkbox" class="custom-control-input" id="WebSpeechSwitch">
                                    <label class="custom-control-label" for="WebSpeechSwitch">@(isPersian ? "استفاده از سیستم تبدیل گفتار به متن داخلی مرورگر کاربر پیش از ارسال فایل صوتی به سرور" : "Use client browser native STT before uploading audio stream to server")</label>
                                </div>
                                <span asp-validation-for="EnableClientWebSpeechFallback" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card card-default">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-brain"></i> @(isPersian ? "انتخاب مدل‌ها و پارامترها" : "Model Selection & Parameters")</h3>
                    </div>
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="ChatbotModel" class="col-form-label">@T("Plugins.Misc.ArtificialIntelligence.ChatbotModel")</label>
                                <i class="fas fa-info-circle text-info ml-1" data-toggle="tooltip" data-placement="top" title="@(isPersian ? "مدل مورد استفاده برای عملیات چت‌بات را انتخاب کنید. هزینه‌های ورودی/خروجی در زیر نشان داده شده است." : "Select the model used for chatbot operations. Input/output costs are shown below.")"></i>
                            </div>
                            <div class="col-md-9">
                                <select asp-for="ChatbotModel" class="form-control" id="ChatbotModelSelect">
                                    @foreach (var modelItem in Model.AvailableChatbotModels)
                                    {
                                        <option value="@modelItem.Value" 
                                                selected="@(modelItem.Value == Model.ChatbotModel)"
                                                data-input="@modelItem.InputPrice"
                                                data-output="@modelItem.OutputPrice"
                                                data-provider="@modelItem.Provider"
                                                data-vision="@modelItem.SupportsVision">
                                            @modelItem.Text
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="ChatbotModel" class="text-danger"></span>
                                <small id="chatbot-model-info" class="form-text text-muted mt-1"></small>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="VisionModel" class="col-form-label">@T("Plugins.Misc.ArtificialIntelligence.VisionModel")</label>
                                <i class="fas fa-info-circle text-info ml-1" data-toggle="tooltip" data-placement="top" title="@(isPersian ? "مدل مورد استفاده برای وظایف تجزیه و تحلیل تصویر و بینایی ماشین را انتخاب کنید." : "Select the model used for image and vision analysis tasks.")"></i>
                            </div>
                            <div class="col-md-9">
                                <select asp-for="VisionModel" class="form-control" id="VisionModelSelect">
                                    @foreach (var modelItem in Model.AvailableVisionModels)
                                    {
                                        <option value="@modelItem.Value" 
                                                selected="@(modelItem.Value == Model.VisionModel)"
                                                data-input="@modelItem.InputPrice"
                                                data-output="@modelItem.OutputPrice"
                                                data-provider="@modelItem.Provider"
                                                data-vision="@modelItem.SupportsVision">
                                            @modelItem.Text
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="VisionModel" class="text-danger"></span>
                                <small id="vision-model-info" class="form-text text-muted mt-1"></small>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="EmbeddingModel" class="col-form-label">@T("Plugins.Misc.ArtificialIntelligence.EmbeddingModel")</label>
                                <i class="fas fa-info-circle text-info ml-1" data-toggle="tooltip" data-placement="top" title="@(isPersian ? "مدل تعبیه‌ساز وکتور (Embedding) مورد استفاده برای نگاشت شباهت محصولات را انتخاب کنید." : "Select the vector embedding model used for product similarity mapping.")"></i>
                            </div>
                            <div class="col-md-9">
                                <select asp-for="EmbeddingModel" class="form-control" id="EmbeddingModelSelect">
                                    @foreach (var modelItem in Model.AvailableEmbeddingModels)
                                    {
                                        <option value="@modelItem.Value" 
                                                selected="@(modelItem.Value == Model.EmbeddingModel)"
                                                data-input="@modelItem.InputPrice"
                                                data-output="@modelItem.OutputPrice"
                                                data-provider="@modelItem.Provider"
                                                data-vision="@modelItem.SupportsVision">
                                            @modelItem.Text
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="EmbeddingModel" class="text-danger"></span>
                                <small id="embedding-model-info" class="form-text text-muted mt-1"></small>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="DuplicateSimilarityThreshold" class="col-form-label">@T("Plugins.Misc.ArtificialIntelligence.DuplicateSimilarityThreshold")</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="DuplicateSimilarityThreshold" type="number" step="0.01" min="0" max="1" class="form-control" />
                                <span asp-validation-for="DuplicateSimilarityThreshold" class="text-danger"></span>
                                <small class="form-text text-muted">@(isPersian ? "حد آستانه شباهت کسینوسی که بالاتر از آن محصولات به عنوان تکراری علامت‌گذاری می‌شوند. پیش‌فرض 0.85 است." : "Cosine similarity score above which products are flagged as duplicates. Default is 0.85.")</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>

<script>
    $(document).ready(function () {
        // Initialize tooltips
        $('[data-toggle="tooltip"]').tooltip();

        var isPersian = @(isPersian ? "true" : "false");
        var providerLabel = isPersian ? "ارائه‌دهنده" : "Provider";
        var inputCostLabel = isPersian ? "هزینه ورودی" : "Input Cost";
        var outputCostLabel = isPersian ? "هزینه خروجی" : "Output Cost";
        var supportsVisionLabel = isPersian ? "پشتیبانی از پردازش تصویر" : "Supports Vision";
        var yesLabel = isPersian ? "بله" : "Yes";
        var noLabel = isPersian ? "خیر" : "No";
        var costLabel = isPersian ? "هزینه" : "Cost";
        var unitsLabel = isPersian ? "واحد به ازای هر ۱۰۰۰ توکن" : "units per 1K tokens";
        var notAvailableLabel = isPersian ? "مدل پیکربندی شده است. قیمت‌ها و جزئیات در دسترس نیستند." : "Configured model. Prices and details not available.";

        function updateModelInfo(selectId, infoId, isEmbedding) {
            var selectedOption = $('#' + selectId + ' option:selected');
            if (selectedOption.length) {
                var inputPrice = parseFloat(selectedOption.data('input'));
                var outputPrice = parseFloat(selectedOption.data('output'));
                var provider = selectedOption.data('provider');
                var vision = selectedOption.data('vision');

                var infoText = "";
                if (provider === "configured") {
                    infoText = notAvailableLabel;
                } else if (isEmbedding) {
                    infoText = providerLabel + ": <strong class='text-primary'>" + provider + "</strong> | " + costLabel + ": <strong class='text-success'>" + inputPrice.toFixed(3) + "</strong> " + unitsLabel;
                } else {
                    infoText = providerLabel + ": <strong class='text-primary'>" + provider + "</strong> | " + inputCostLabel + ": <strong class='text-success'>" + inputPrice.toFixed(3) + "</strong> | " + outputCostLabel + ": <strong class='text-success'>" + outputPrice.toFixed(3) + "</strong> | " + supportsVisionLabel + ": <strong class='" + (String(vision).toLowerCase() === 'true' ? "text-success" : "text-danger") + "'>" + (String(vision).toLowerCase() === 'true' ? yesLabel : noLabel) + "</strong>";
                }
                $('#' + infoId).html(infoText);
            }
        }

        // Bind events
        $('#ChatbotModelSelect').change(function () {
            updateModelInfo('ChatbotModelSelect', 'chatbot-model-info', false);
        });
        $('#VisionModelSelect').change(function () {
            updateModelInfo('VisionModelSelect', 'vision-model-info', false);
        });
        $('#EmbeddingModelSelect').change(function () {
            updateModelInfo('EmbeddingModelSelect', 'embedding-model-info', true);
        });

        // Provider selection toggle
        function toggleProviderSections() {
            var val = $('#ProviderTypeSelect').val();
            if (val === "1") {
                $('#local-provider-card').show();
                $('#cloud-provider-section').hide();
            } else if (val === "0") {
                $('#local-provider-card').show(); // Keep both available for editing or toggle visibility
                $('#cloud-provider-section').show();
            } else {
                $('#local-provider-card').hide();
                $('#cloud-provider-section').hide();
            }
        }

        $('#ProviderTypeSelect').change(toggleProviderSections);
        toggleProviderSections();

        // Initial update
        updateModelInfo('ChatbotModelSelect', 'chatbot-model-info', false);
        updateModelInfo('VisionModelSelect', 'vision-model-info', false);
        updateModelInfo('EmbeddingModelSelect', 'embedding-model-info', true);
    });
</script>
