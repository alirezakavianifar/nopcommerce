@model Nop.Plugin.Misc.ArtificialIntelligence.Models.AiSettingsModel
@using Nop.Web.Framework.Extensions

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Misc.ArtificialIntelligence.Configure").Text;
}

<form asp-controller="AiAdmin" asp-action="Configure" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Misc.ArtificialIntelligence.Configure")
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i> @T("Admin.Common.Save")
            </button>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="card card-default">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-cog"></i> @T("Admin.Configuration")</h3>
                    </div>
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="SandboxMode" class="col-form-label">@T("Plugins.Misc.ArtificialIntelligence.SandboxMode")</label>
                            </div>
                            <div class="col-md-9">
                                <div class="custom-control custom-switch">
                                    <input asp-for="SandboxMode" type="checkbox" class="custom-control-input" id="SandboxModeSwitch">
                                    <label class="custom-control-label" for="SandboxModeSwitch">Enable Sandbox (No external API calls, tests will use simulated responses)</label>
                                </div>
                                <span asp-validation-for="SandboxMode" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="ApiKey" class="col-form-label">@T("Plugins.Misc.ArtificialIntelligence.ApiKey")</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="ApiKey" class="form-control" placeholder="Enter AvalAI API Key (Bearer Token)" />
                                <span asp-validation-for="ApiKey" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="BaseUrl" class="col-form-label">@T("Plugins.Misc.ArtificialIntelligence.BaseUrl")</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="BaseUrl" class="form-control" />
                                <span asp-validation-for="BaseUrl" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="CreditThreshold" class="col-form-label">@T("Plugins.Misc.ArtificialIntelligence.CreditThreshold")</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="CreditThreshold" type="number" class="form-control" placeholder="Enter threshold in Tomans" />
                                <span asp-validation-for="CreditThreshold" class="text-danger"></span>
                                <small class="form-text text-muted">A system warning will be triggered when the remaining credit reaches or drops below this threshold.</small>
                            </div>
                        </div>

                        @if (Model.CurrentCredit.HasValue)
                        {
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <label class="col-form-label">@T("Plugins.Misc.ArtificialIntelligence.CurrentCredit")</label>
                                </div>
                                <div class="col-md-9">
                                    <div class="form-control-plaintext font-weight-bold @(Model.CurrentCredit <= Model.CreditThreshold ? "text-danger" : "text-success")">
                                        @Model.CurrentCredit.Value.ToString("N0") Tomans
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card card-default">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-brain"></i> Model Selection & Parameters</h3>
                    </div>
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="ChatbotModel" class="col-form-label">@T("Plugins.Misc.ArtificialIntelligence.ChatbotModel")</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="ChatbotModel" class="form-control" />
                                <span asp-validation-for="ChatbotModel" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="VisionModel" class="col-form-label">@T("Plugins.Misc.ArtificialIntelligence.VisionModel")</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="VisionModel" class="form-control" />
                                <span asp-validation-for="VisionModel" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="EmbeddingModel" class="col-form-label">@T("Plugins.Misc.ArtificialIntelligence.EmbeddingModel")</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="EmbeddingModel" class="form-control" />
                                <span asp-validation-for="EmbeddingModel" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="DuplicateSimilarityThreshold" class="col-form-label">@T("Plugins.Misc.ArtificialIntelligence.DuplicateSimilarityThreshold")</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="DuplicateSimilarityThreshold" type="number" step="0.01" min="0" max="1" class="form-control" />
                                <span asp-validation-for="DuplicateSimilarityThreshold" class="text-danger"></span>
                                <small class="form-text text-muted">Cosine similarity score above which products are flagged as duplicates. Default is 0.85.</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
