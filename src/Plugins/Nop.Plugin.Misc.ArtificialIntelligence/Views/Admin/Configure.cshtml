@model Nop.Plugin.Misc.ArtificialIntelligence.Models.AiSettingsModel
@using Nop.Web.Framework.Extensions

@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "Configure AI Settings (AvalAI)";
}

<form asp-controller="AiAdmin" asp-action="Configure" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            Configure AI Settings (AvalAI)
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i> Save Settings
            </button>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="card card-default">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-cog"></i> API Connection Settings</h3>
                    </div>
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="SandboxMode" class="col-form-label">Sandbox / Mock Mode</label>
                            </div>
                            <div class="col-md-9">
                                <div class="custom-control custom-switch">
                                    <input asp-for="SandboxMode" type="checkbox" class="custom-control-input" id="SandboxModeSwitch">
                                    <label class="custom-control-label" for="SandboxModeSwitch">Enable Sandbox (No external API calls, tests will use simulated responses)</label>
                                </div>
                                <span asp-validation-for="SandboxMode" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="ApiKey" class="col-form-label">AvalAI API Key</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="ApiKey" class="form-control" placeholder="Enter AvalAI API Key (Bearer Token)" />
                                <span asp-validation-for="ApiKey" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="BaseUrl" class="col-form-label">Base API URL</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="BaseUrl" class="form-control" />
                                <span asp-validation-for="BaseUrl" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card card-default">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-brain"></i> Model Selection & Parameters</h3>
                    </div>
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="ChatbotModel" class="col-form-label">Chatbot Completions Model</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="ChatbotModel" class="form-control" />
                                <span asp-validation-for="ChatbotModel" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="VisionModel" class="col-form-label">Vision/Image analysis Model</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="VisionModel" class="form-control" />
                                <span asp-validation-for="VisionModel" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="EmbeddingModel" class="col-form-label">Embeddings Model</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="EmbeddingModel" class="form-control" />
                                <span asp-validation-for="EmbeddingModel" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <label asp-for="DuplicateSimilarityThreshold" class="col-form-label">Duplicate Similarity Threshold (0.0 - 1.0)</label>
                            </div>
                            <div class="col-md-9">
                                <input asp-for="DuplicateSimilarityThreshold" type="number" step="0.01" min="0" max="1" class="form-control" />
                                <span asp-validation-for="DuplicateSimilarityThreshold" class="text-danger"></span>
                                <small class="form-text text-muted">Cosine similarity score above which products are flagged as duplicates. Default is 0.85.</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
