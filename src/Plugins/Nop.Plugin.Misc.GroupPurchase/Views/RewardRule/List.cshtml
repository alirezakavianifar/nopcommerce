@model Nop.Plugin.Misc.GroupPurchase.Models.RewardRuleSearchModel
@using Nop.Web.Framework.Models.DataTables
@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Misc.GroupPurchase.RewardRule.Manage").Text;
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Plugins.Misc.GroupPurchase.RewardRule.Manage")
    </h1>
    <div class="float-right">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-square"></i>
            @T("Admin.Common.AddNew")
        </a>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-body">
                        @await Html.PartialAsync("Table", new DataTablesModel
                        {
                            Name = "rewardrules-grid",
                            UrlRead = new DataUrl("ListData", "RewardRule", null),
                            Length = Model.PageSize,
                            LengthMenu = Model.AvailablePageSizes,
                            ColumnCollection = new List<ColumnProperty>
                            {
                                new ColumnProperty(nameof(RewardRuleModel.TargetRoleName))
                                {
                                    Title = T("Plugins.Misc.GroupPurchase.RewardRule.Fields.TargetRole").Text
                                },
                                new ColumnProperty(nameof(RewardRuleModel.RewardTypeName))
                                {
                                    Title = T("Plugins.Misc.GroupPurchase.RewardRule.Fields.RewardType").Text
                                },
                                new ColumnProperty(nameof(RewardRuleModel.CalculationTypeName))
                                {
                                    Title = T("Plugins.Misc.GroupPurchase.RewardRule.Fields.CalculationType").Text
                                },
                                new ColumnProperty(nameof(RewardRuleModel.Value))
                                {
                                    Title = T("Plugins.Misc.GroupPurchase.RewardRule.Fields.Value").Text
                                },
                                new ColumnProperty(nameof(RewardRuleModel.Id))
                                {
                                    Title = T("Admin.Common.Edit").Text,
                                    Width = "100",
                                    ClassName =  NopColumnClassDefaults.Button,
                                    Render = new RenderButtonEdit(new DataUrl("~/Admin/RewardRule/Edit/"))
                                }
                            }
                        })
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
