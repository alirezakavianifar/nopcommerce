@model Nop.Plugin.Misc.GroupPurchase.Models.CommissionModel

<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden" />

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-body">
                        
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="CommissionScopeId" />
                            </div>
                            <div class="col-md-9">
                                <nop-select asp-for="CommissionScopeId" asp-items="@(((Nop.Plugin.Misc.GroupPurchase.Domain.CommissionScope)Model.CommissionScopeId).ToSelectList())" />
                                <span asp-validation-for="CommissionScopeId"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="EntityId" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="EntityId" />
                                <span asp-validation-for="EntityId"></span>
                                <small class="form-text text-muted">@T("Plugins.Misc.GroupPurchase.Commission.Fields.EntityId.Hint")</small>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="EntityName" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="EntityName" />
                                <span asp-validation-for="EntityName"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="Percentage" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="Percentage" />
                                <span asp-validation-for="Percentage"></span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
