@model Nop.Plugin.Misc.GroupPurchase.Models.CustomerWalletModel
@{
    Layout = "_ColumnsTwo";
}

@section accountNavigation
{
    @await Component.InvokeAsync("CustomerNavigation", new { selectedTabId = 0 })
}

<div class="page account-page">
    <div class="page-title">
        <h1>My Wallet</h1>
    </div>
    <div class="page-body">
        <div class="fieldset">
            <div class="title">
                <strong>Wallet Balances</strong>
            </div>
            <div class="form-fields">
                <div class="inputs">
                    <label>Regular Balance:</label>
                    <span class="value">@Model.RegularBalance.ToString("C")</span>
                </div>
                <div class="inputs">
                    <label>Group Purchase Reward Balance:</label>
                    <span class="value">@Model.GroupRewardBalance.ToString("C")</span>
                </div>
            </div>
        </div>
    </div>
</div>
