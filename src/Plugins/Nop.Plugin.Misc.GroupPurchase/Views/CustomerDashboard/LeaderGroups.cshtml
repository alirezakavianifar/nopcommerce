@model Nop.Plugin.Misc.GroupPurchase.Models.CustomerLeaderGroupListModel
@inject Nop.Services.Localization.ILocalizationService localizationService
@{
    Layout = "_ColumnsTwo";

    var title = await localizationService.GetResourceAsync("Plugins.Misc.GroupPurchase.Customer.LeaderGroupsTitle");
    if (string.IsNullOrEmpty(title) || title.ToLower().StartsWith("plugins.")) { title = "گروه‌های لیدری من"; }

    var codeHeader = await localizationService.GetResourceAsync("Plugins.Misc.GroupPurchase.Customer.GroupCode");
    if (string.IsNullOrEmpty(codeHeader) || codeHeader.ToLower().StartsWith("plugins.")) { codeHeader = "کد گروه"; }

    var statusHeader = await localizationService.GetResourceAsync("Plugins.Misc.GroupPurchase.Customer.Status");
    if (string.IsNullOrEmpty(statusHeader) || statusHeader.ToLower().StartsWith("plugins.")) { statusHeader = "وضعیت"; }

    var createdHeader = await localizationService.GetResourceAsync("Plugins.Misc.GroupPurchase.Customer.CreatedOn");
    if (string.IsNullOrEmpty(createdHeader) || createdHeader.ToLower().StartsWith("plugins.")) { createdHeader = "تاریخ ایجاد"; }

    var membersHeader = await localizationService.GetResourceAsync("Plugins.Misc.GroupPurchase.Customer.Members");
    if (string.IsNullOrEmpty(membersHeader) || membersHeader.ToLower().StartsWith("plugins.")) { membersHeader = "تعداد اعضا"; }

    var cityHeader = await localizationService.GetResourceAsync("Plugins.Misc.GroupPurchase.Customer.DeliveryCity");
    if (string.IsNullOrEmpty(cityHeader) || cityHeader.ToLower().StartsWith("plugins.")) { cityHeader = "شهر تحویل"; }

    var noDataMsg = await localizationService.GetResourceAsync("Plugins.Misc.GroupPurchase.Customer.NoLeaderGroups");
    if (string.IsNullOrEmpty(noDataMsg) || noDataMsg.ToLower().StartsWith("plugins.")) { noDataMsg = "شما هنوز هیچ گروه خریدی ایجاد نکرده‌اید."; }
}

@section left
{
    @await Component.InvokeAsync("CustomerNavigation", new { selectedTabId = 0 })
}

<div class="page account-page">
    <div class="page-title">
        <h1>@title</h1>
    </div>
    <div class="page-body">
        @if (Model.Data.Any())
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <colgroup>
                        <col />
                        <col />
                        <col />
                        <col />
                        <col />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>@codeHeader</th>
                            <th>@statusHeader</th>
                            <th>@createdHeader</th>
                            <th>@membersHeader</th>
                            <th>@cityHeader</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Data)
                        {
                            <tr>
                                <td>@item.UniqueCode</td>
                                <td>@item.Status</td>
                                <td>@item.CreatedOnUtc.ToString("g")</td>
                                <td>@item.MembersCount</td>
                                <td>@item.DeliveryCity</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="no-data">
                @noDataMsg
            </div>
        }
    </div>
</div>
