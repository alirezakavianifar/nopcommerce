@model Nop.Plugin.Misc.GroupPurchase.Models.CustomerLeaderGroupListModel
@{
    Layout = "_ColumnsTwo";
}

@section accountNavigation
{
    @await Component.InvokeAsync("CustomerNavigation", new { selectedTabId = 0 })
}

<div class="page account-page">
    <div class="page-title">
        <h1>My Leader Groups</h1>
    </div>
    <div class="page-body">
        @if (Model.Data.Any())
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <colgroup>
                        <col />
                        <col />
                        <col />
                        <col />
                        <col />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Group Code</th>
                            <th>Status</th>
                            <th>Created On</th>
                            <th>Members</th>
                            <th>Delivery City</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Data)
                        {
                            <tr>
                                <td>@item.UniqueCode</td>
                                <td>@item.Status</td>
                                <td>@item.CreatedOnUtc.ToString("g")</td>
                                <td>@item.MembersCount</td>
                                <td>@item.DeliveryCity</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="no-data">
                You have not created any group purchases yet.
            </div>
        }
    </div>
</div>
