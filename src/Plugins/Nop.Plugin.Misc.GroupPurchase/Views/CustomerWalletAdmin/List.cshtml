@model Nop.Plugin.Misc.GroupPurchase.Models.CustomerWalletSearchModel
@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = "Customer Wallets";
}

<div class="content-header clearfix">
    <h1 class="float-left">
        Customer Wallets
    </h1>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-body">
                        @await Html.PartialAsync("Table", new DataTablesModel
                        {
                            Name = "wallets-grid",
                            UrlRead = new DataUrl("ListData", "CustomerWalletAdmin", null),
                            SearchButtonId = "search-wallets",
                            Length = Model.PageSize,
                            LengthMenu = Model.AvailablePageSizes,
                            ColumnCollection = new List<ColumnProperty>
                            {
                                new ColumnProperty(nameof(CustomerWalletAdminModel.Id)) { Title = "ID", Width = "50" },
                                new ColumnProperty(nameof(CustomerWalletAdminModel.CustomerEmail)) { Title = "Customer Email", Width = "200" },
                                new ColumnProperty(nameof(CustomerWalletAdminModel.WalletTypeName)) { Title = "Wallet Type", Width = "150" },
                                new ColumnProperty(nameof(CustomerWalletAdminModel.Balance)) { Title = "Balance", Width = "100" },
                                new ColumnProperty(nameof(CustomerWalletAdminModel.UpdatedOnUtc)) { Title = "Last Updated (UTC)", Width = "150" }
                            }
                        })
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
