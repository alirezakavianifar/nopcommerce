@model Nop.Plugin.Misc.SellerMarketing.Models.SellerRestoreRequestSearchModel
@using Nop.Web.Framework.Models.DataTables
@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Misc.SellerMarketing.Backup.RestoreRequestsQueue").Text;
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Plugins.Misc.SellerMarketing.Backup.RestoreRequestsQueue")
    </h1>
    <div class="float-right">
        <a asp-action="Configure" class="btn btn-secondary">
            <i class="fas fa-cog"></i>
            @T("Plugins.Misc.SellerMarketing.Backup.AdminSettings")
        </a>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-body">
                        @await Html.PartialAsync("Table", new DataTablesModel
                        {
                            Name = "restorerequests-grid",
                            UrlRead = new DataUrl("RestoreRequestsData", "SellerBackupAdmin", null),
                            Length = Model.PageSize,
                            LengthMenu = Model.AvailablePageSizes,
                            ColumnCollection = new List<ColumnProperty>
                            {
                                new ColumnProperty(nameof(SellerRestoreRequestModel.Id))
                                {
                                    Title = "#",
                                    Width = "60"
                                },
                                new ColumnProperty(nameof(SellerRestoreRequestModel.VendorName))
                                {
                                    Title = T("Plugins.Misc.SellerMarketing.Backup.Vendor").Text
                                },
                                new ColumnProperty(nameof(SellerRestoreRequestModel.IsExternalUpload))
                                {
                                    Title = T("Plugins.Misc.SellerMarketing.Backup.Source").Text,
                                    Render = new RenderCustom("renderSourceColumn")
                                },
                                new ColumnProperty(nameof(SellerRestoreRequestModel.StatusName))
                                {
                                    Title = T("Plugins.Misc.SellerMarketing.Backup.Status").Text
                                },
                                new ColumnProperty(nameof(SellerRestoreRequestModel.RequestedOn))
                                {
                                    Title = T("Plugins.Misc.SellerMarketing.Backup.RequestedOn").Text,
                                    Render = new RenderDate()
                                },
                                new ColumnProperty(nameof(SellerRestoreRequestModel.AdminComment))
                                {
                                    Title = T("Plugins.Misc.SellerMarketing.Backup.AdminComment").Text
                                },
                                new ColumnProperty(nameof(SellerRestoreRequestModel.Id))
                                {
                                    Title = T("Admin.Common.Actions").Text,
                                    Width = "200",
                                    ClassName = NopColumnClassDefaults.Button,
                                    Render = new RenderCustom("renderActionButtons")
                                }
                            }
                        })
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function renderSourceColumn(data, type, row, meta) {
        return row.IsExternalUpload 
            ? '<span class="badge badge-warning" style="background:#fd7e14;color:#fff;padding:3px 6px;border-radius:3px;">External Upload</span>' 
            : '<span class="badge badge-info" style="background:#17a2b8;color:#fff;padding:3px 6px;border-radius:3px;">Server Archive</span>';
    }

    function renderActionButtons(data, type, row, meta) {
        if (row.StatusName === "PendingApproval") {
            return '<form action="@Url.Action("Approve", "SellerBackupAdmin")" method="post" style="display:inline-block;margin-right:5px;">' +
                   '@Html.AntiForgeryToken()' +
                   '<input type="hidden" name="id" value="' + row.Id + '" />' +
                   '<button type="submit" class="btn btn-sm btn-success" onclick="return confirm(\'Approve and execute restore for this vendor?\');"><i class="fa fa-check"></i> Approve</button>' +
                   '</form>' +
                   '<form action="@Url.Action("Reject", "SellerBackupAdmin")" method="post" style="display:inline-block;">' +
                   '@Html.AntiForgeryToken()' +
                   '<input type="hidden" name="id" value="' + row.Id + '" />' +
                   '<button type="submit" class="btn btn-sm btn-danger" onclick="return confirm(\'Reject this restore request?\');"><i class="fa fa-times"></i> Reject</button>' +
                   '</form>';
        } else {
            return '<span class="text-muted">' + row.StatusName + '</span>';
        }
    }
</script>
