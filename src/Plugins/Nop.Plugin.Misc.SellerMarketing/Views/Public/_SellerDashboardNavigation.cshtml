<li class="customer-seller-dashboard @if (Url.ActionContext.RouteData.Values["controller"]?.ToString() == "SellerMarketingPublic" && Url.ActionContext.RouteData.Values["action"]?.ToString() == "Dashboard") { <text>active</text> }">
    <a href="@Url.RouteUrl("Plugin.Misc.SellerMarketing.Public.Dashboard")" class="inactive">@T("Plugins.Misc.SellerMarketing.Dashboard.MyAccountTab")</a>
</li>
<li class="customer-seller-backup @if (Url.ActionContext.RouteData.Values["controller"]?.ToString() == "SellerBackupPublic") { <text>active</text> }">
    <a href="@Url.RouteUrl("Plugin.Misc.SellerMarketing.Public.Backup")" class="inactive">@T("Plugins.Misc.SellerMarketing.Backup.Title")</a>
</li>
