@model ConfigurationModel
@{
    Layout = "_ConfigurePlugin";
}

<form asp-controller="SMSAuthenticationAdmin" asp-action="Configure" method="post">    
    <section class="content">
        <div class="container-fluid">
            <div class="card card-default">
                <div class="card-header">
                    <h3 class="card-title">SMS 2FA Gateway Settings</h3>
                </div>
                <div class="card-body">
                    <div class="form-group row">                    
                        <div class="col-md-3">
                            <nop-label asp-for="Provider" />
                        </div>
                        <div class="col-md-9">
                            <select asp-for="Provider" class="form-control">
                                <option value="Generic">Generic Webhook / HTTP GET</option>
                                <option value="Twilio">Twilio</option>
                                <option value="Kavenegar">Kavenegar</option>
                                <option value="Melipayamak">Melipayamak</option>
                            </select>
                            <span asp-validation-for="Provider"></span>
                        </div>
                    </div>
                    <div class="form-group row">                    
                        <div class="col-md-3">
                            <nop-label asp-for="ApiKey" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="ApiKey" />
                            <span asp-validation-for="ApiKey"></span>
                        </div>
                    </div>
                    <div class="form-group row">                    
                        <div class="col-md-3">
                            <nop-label asp-for="ApiSecret" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="ApiSecret" />
                            <span asp-validation-for="ApiSecret"></span>
                        </div>
                    </div>
                    <div class="form-group row">                    
                        <div class="col-md-3">
                            <nop-label asp-for="SenderNumber" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="SenderNumber" />
                            <span asp-validation-for="SenderNumber"></span>
                        </div>
                    </div>
                    <div class="form-group row">                    
                        <div class="col-md-3">
                            <nop-label asp-for="CodeLength" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="CodeLength" />
                            <span asp-validation-for="CodeLength"></span>
                        </div>
                    </div>
                    <div class="form-group row">                    
                        <div class="col-md-3">
                            <nop-label asp-for="CodeLifetimeMinutes" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="CodeLifetimeMinutes" />
                            <span asp-validation-for="CodeLifetimeMinutes"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card card-default">
                <div class="card-header">
                    <h3 class="card-title">Forced Roles & Security Restrictions</h3>
                </div>
                <div class="card-body">
                    <div class="form-group row">                    
                        <div class="col-md-3">
                            <nop-label asp-for="Force2FAForAdmins" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="Force2FAForAdmins" />
                            <span asp-validation-for="Force2FAForAdmins"></span>
                        </div>
                    </div>
                    <div class="form-group row">                    
                        <div class="col-md-3">
                            <nop-label asp-for="Force2FAForVendors" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="Force2FAForVendors" />
                            <span asp-validation-for="Force2FAForVendors"></span>
                        </div>
                    </div>
                    <div class="form-group row">                    
                        <div class="col-md-3">
                            <nop-label asp-for="EnableIpAllowlist" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="EnableIpAllowlist" />
                            <span asp-validation-for="EnableIpAllowlist"></span>
                        </div>
                    </div>
                    <div class="form-group row">                    
                        <div class="col-md-3">
                            <nop-label asp-for="EnableDeviceBinding" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="EnableDeviceBinding" />
                            <span asp-validation-for="EnableDeviceBinding"></span>
                        </div>
                    </div>
                    <div class="form-group row">                    
                        <div class="col-md-3">
                            <nop-label asp-for="ForceDeviceBindingForAdmins" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="ForceDeviceBindingForAdmins" />
                            <span asp-validation-for="ForceDeviceBindingForAdmins"></span>
                        </div>
                    </div>
                    <div class="form-group row">                    
                        <div class="col-md-3">
                            <nop-label asp-for="ForceDeviceBindingForVendors" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="ForceDeviceBindingForVendors" />
                            <span asp-validation-for="ForceDeviceBindingForVendors"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-9 offset-md-3">
                            <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
